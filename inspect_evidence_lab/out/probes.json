{
  "probes": [
    {
      "id": "P1",
      "title": "同一 loader、同一 SourceMetadata：历史槽位折叠，较早输入丢失",
      "received_inputs": [
        {
          "pass": 1,
          "DYNACONF_LAB_PROBE": "first",
          "effective_after": "first"
        },
        {
          "pass": 2,
          "DYNACONF_LAB_PROBE": "second",
          "effective_after": "second"
        }
      ],
      "final_key_history": [
        {
          "loader": "env_global",
          "identifier": "DYNACONF",
          "env": "global",
          "merged": false,
          "value": "second"
        }
      ],
      "surviving_slot": {
        "metadata": {
          "loader": "env_global",
          "identifier": "DYNACONF",
          "env": "global",
          "merged": false
        },
        "data": {
          "LAB_PROBE": "second"
        }
      },
      "boundary": "最终 inspect/loaded_by_loaders 只剩 second；first 无法从最终历史恢复，只能靠当时的步骤日志或外部环境快照证明。"
    },
    {
      "id": "P2",
      "title": "历史里的 value 不是“原始输入”：合并写入会被原地累积改写",
      "input_object_before_set": {
        "policy": {
          "mfa_provider": "totp"
        }
      },
      "history_slot_SECURITY_after_set": {
        "require_mfa": true,
        "session_timeout": 30,
        "policy": {
          "min_password_length": 12,
          "issuer": "corp-local",
          "mfa_provider": "totp"
        }
      },
      "leaf_history_entries_for_target_from_this_slot": [
        {
          "loader": "set_method",
          "identifier": "undefined",
          "env": "global",
          "merged": true,
          "value": true
        }
      ],
      "boundary": "object_merge(old, new) 会把 old 合并进 new 并原地改写 new；因此该槽位最终 blob 含调用时并未显式给出的 require_mfa。叶子历史出现某来源，不等于该来源显式写过这个叶子。‘实际收到的输入’必须在 set 入口深拷贝固定。"
    },
    {
      "id": "P3",
      "title": "嵌套属性直改不进历史：持续偏离会留下‘当前值≠历史值’矛盾，还原后无痕",
      "history_leaf_values_before": [
        true
      ],
      "after_mutation_current": false,
      "history_leaf_values_during_mutation": [
        true
      ],
      "current_vs_history_mismatch_detectable": true,
      "after_restore_current": true,
      "history_leaf_values_after_restore": [
        true
      ],
      "restored_is_indistinguishable_in_history": true,
      "boundary": "若当前值与全部历史叶子值都不一致，可证明存在历史未记录的写入，但不能确定主体/时间；若事后还原成与历史相容的值，最终 inspect 无异常。"
    },
    {
      "id": "P4",
      "title": "真正完成加载后才出现的环境变量：不重新加载就不进 inspect",
      "warmup_key": "security.require_mfa",
      "env_var_added_after_warmup": {
        "DYNACONF_LATE_ONLY": "ghost-after-init"
      },
      "effective_without_reload": null,
      "history_query_result": "KeyNotFoundError: The requested key was not found: 'LATE_ONLY'",
      "boundary": "最终 inspect 无法证明该环境变量曾存在；需要进程环境快照、shell/编排日志或重新加载后的 inspect 才能观察。"
    },
    {
      "id": "P5",
      "title": "LazySettings 时间零点陷阱：首次 get 前注入的变量会被当作启动环境",
      "setup_pending_before_first_get": true,
      "env_var_set_between_constructor_and_first_get": {
        "DYNACONF_LATE_ONLY": "ghost-before-first-get"
      },
      "effective_on_first_get": "ghost-before-first-get",
      "history": [
        {
          "loader": "env_global",
          "identifier": "DYNACONF",
          "env": "global",
          "merged": false,
          "value": "ghost-before-first-get"
        }
      ],
      "boundary": "证据时间线的零点是首次真正访问/execute_loaders，而非 Dynaconf(...) 构造语句的位置；判断‘是否启动时已有此 env’需要知道进程内第一次访问 settings 的时点。"
    }
  ],
  "dynaconf_version": "3.3.6.dev0"
}
