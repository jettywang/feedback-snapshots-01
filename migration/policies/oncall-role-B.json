{
  "Version": "2012-10-17",
  "Id": "OnCallRoleB",
  "Statement": [
    {
      "Sid": "B1S3EvidencePrefixRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::oncall-evidence",
        "arn:aws:s3:::oncall-evidence/incidents/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "111111111111",
          "s3:prefix": "incidents/"
        },
        "Bool": { "s3:TlsVersion": ["true"] }
      }
    },
    {
      "Sid": "B2DdbTicketIndexRead",
      "Effect": "Allow",
      "Action": ["dynamodb:Query", "dynamodb:DescribeTable"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:111111111111:table/oncall-tickets",
        "arn:aws:dynamodb:us-east-1:111111111111:table/oncall-tickets/index/*"
      ],
      "Condition": {
        "StringEquals": { "aws:ResourceTag/DataClass": "internal" }
      }
    },
    {
      "Sid": "B3SharedKmsKeyRead",
      "Effect": "Allow",
      "Action": ["kms:DescribeKey"],
      "Resource": ["arn:aws:kms:us-east-1:111111111111:key/11111111-1111-1111-1111-111111111111"],
      "Condition": {
        "StringEquals": { "aws:ResourceTag/DataClass": "internal" }
      }
    }
  ]
}
