{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S11",
      "Effect": "Allow",
      "Action": [
        "s3:getbucketlocation",
        "s3:getobject",
        "s3:listbucket"
      ],
      "Resource": [
        "arn:aws:s3:::oncall-evidence",
        "arn:aws:s3:::oncall-evidence/*"
      ],
      "Condition": {
        "Bool": {
          "s3:TlsVersion": [
            "true"
          ]
        },
        "StringEquals": {
          "s3:ResourceAccount": "111111111111"
        }
      }
    },
    {
      "Sid": "S12",
      "Effect": "Allow",
      "Action": [
        "dynamodb:describetable",
        "dynamodb:getitem",
        "dynamodb:query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:111111111111:table/oncall-tickets",
        "arn:aws:dynamodb:us-east-1:111111111111:table/oncall-tickets/index/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DataClass": "internal"
        }
      }
    },
    {
      "Sid": "S13",
      "Effect": "Allow",
      "Action": [
        "kms:describekey"
      ],
      "Resource": [
        "arn:aws:kms:us-east-1:111111111111:key/11111111-1111-1111-1111-111111111111"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/DataClass": "internal"
        }
      }
    }
  ]
}
